# Auth.js Credentials Provider (single creator)
CREATOR_EMAIL=
CREATOR_PASSWORD=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
DATABASE_URL="file:./prisma/dev.db"
TLS_CERT_PATH=
TLS_KEY_PATH=
TLS_CA_PATH=
HTTPS_ENABLED=true

# Site operator details shown on the legal pages (/impressum).
# Leave blank to render the explicit "not configured" state — never fill these
# with placeholder data, an invented name or address is worse than none.
# Required - the page stays in the "not configured" state until all of these are
# set, and SITE_OPERATOR_EMAIL must be a syntactically valid address.
SITE_OPERATOR_NAME=
SITE_OPERATOR_STREET=
SITE_OPERATOR_POSTAL_CODE=
SITE_OPERATOR_CITY=
SITE_OPERATOR_EMAIL=
# Optional - each is rendered only when set.
SITE_OPERATOR_COUNTRY=
SITE_OPERATOR_PHONE=
# For a company rather than a private individual (legal form, e.g. "GmbH";
# authorized representative; register court and number; VAT ID per Sec. 5 DDG).
SITE_OPERATOR_LEGAL_FORM=
SITE_OPERATOR_REPRESENTATIVE=
SITE_OPERATOR_REGISTER=
SITE_OPERATOR_VAT_ID=
# Sec. 18(2) MStV asks for the name AND address of the responsible person.
SITE_OPERATOR_CONTENT_RESPONSIBLE=
SITE_OPERATOR_CONTENT_RESPONSIBLE_ADDRESS=
