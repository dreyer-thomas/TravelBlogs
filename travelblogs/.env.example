# Auth.js Credentials Provider (single creator)
CREATOR_EMAIL=
CREATOR_PASSWORD=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
DATABASE_URL="file:./prisma/dev.db"
TLS_CERT_PATH=
TLS_KEY_PATH=
TLS_CA_PATH=
HTTPS_ENABLED=true

# Site operator details shown on the legal pages (/impressum).
# Leave blank to render the explicit "not configured" state — never fill these
# with placeholder data, an invented name or address is worse than none.
# Required - the page stays in the "not configured" state until all of these are
# set, and SITE_OPERATOR_EMAIL must be a syntactically valid address.
SITE_OPERATOR_NAME=
SITE_OPERATOR_STREET=
SITE_OPERATOR_POSTAL_CODE=
SITE_OPERATOR_CITY=
SITE_OPERATOR_EMAIL=
# Optional - each is rendered only when set.
SITE_OPERATOR_COUNTRY=
SITE_OPERATOR_PHONE=
# For a company rather than a private individual (legal form, e.g. "GmbH";
# authorized representative; register court and number; VAT ID per Sec. 5 DDG).
SITE_OPERATOR_LEGAL_FORM=
SITE_OPERATOR_REPRESENTATIVE=
SITE_OPERATOR_REGISTER=
SITE_OPERATOR_VAT_ID=
# Sec. 18(2) MStV asks for the name AND address of the responsible person.
SITE_OPERATOR_CONTENT_RESPONSIBLE=
SITE_OPERATOR_CONTENT_RESPONSIBLE_ADDRESS=

# Privacy policy (/datenschutz).
# The page always renders the processing inventory -- what data this site
# handles, why and where it goes -- because that is a description of the code
# and holds regardless. These variables are the part only the operator can
# state: the legal basis for each activity, retention, and how to exercise data
# subject rights. Until ALL of the required ones below are set the page shows an
# explicit "not yet published" notice instead of presenting anything as the
# operator's own policy, and nothing you enter here is shown until every
# required field is complete. Have the wording reviewed before publishing it.
# If the page stays unpublished, the server log names the variable at fault.
# The SITE_OPERATOR_* block must be complete too: a policy that is "in effect"
# while naming no controller is not a publishable state.
# Placeholder values ("tbd", "todo", "n/a", "-", "xxx", ...) count as unset
# everywhere below, so a stub can never ship as the operator's own statement.
# Required - an ISO date (YYYY-MM-DD) that has already arrived; "tbd", a
# German-format date and a future date are all rejected.
SITE_PRIVACY_EFFECTIVE_DATE=
# Required - how long each kind of data is kept, and what triggers deletion.
# Line breaks are preserved, so a multi-line retention schedule renders as one.
SITE_PRIVACY_RETENTION=
# Required - how a person exercises access, rectification, erasure, objection
# and the right to complain to a supervisory authority.
SITE_PRIVACY_RIGHTS=
# Required - one legal basis per processing activity (e.g. "Art. 6(1)(f) GDPR").
# Leaving any single one blank keeps the whole page unpublished on purpose: a
# policy that covers eight activities and silently skips the ninth still reads
# as finished, and the gap is the one thing a reader would never spot.
SITE_PRIVACY_LEGAL_BASIS_ACCOUNT=
SITE_PRIVACY_LEGAL_BASIS_TRIP_CONTENT=
SITE_PRIVACY_LEGAL_BASIS_LOCATION=
SITE_PRIVACY_LEGAL_BASIS_WEATHER=
# Map tiles are the only third-party transfer from the reader's browser: every
# reader of a shared trip sends their IP and User-Agent to the OpenStreetMap
# Foundation. This is the entry to get right.
SITE_PRIVACY_LEGAL_BASIS_MAP_TILES=
SITE_PRIVACY_LEGAL_BASIS_SHARE_LINKS=
SITE_PRIVACY_LEGAL_BASIS_ACCESS_LOGS=
SITE_PRIVACY_LEGAL_BASIS_VIEW_COUNTS=
SITE_PRIVACY_LEGAL_BASIS_COOKIES=
# Optional - named in the server-access-log section when set.
SITE_PRIVACY_HOSTING=
